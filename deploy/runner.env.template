# The runner (runbook 5bj): a second engine instance for the untaxed tier (token tax under 100 bps) on launches with NO crowd,
# first or behind one in the seat block, exit on the mark: take-profit +30%, stop -30%, cap 300 blocks. Written by
# deploy/runner_setup.sh install into /etc/sniper/runner.env (root, 0600). Comments only on their own lines (systemd).
# live: SEND_MODULE=/etc/sniper/send_step.py (runner_setup.sh live sets it); empty = DRY RUN (decisions logged, nothing sent)
SEND_MODULE=
PRIVATE_KEY=@PRIVATE_KEY@
WALLET=@WALLET@
# connections: the sniper's, minus the provider socket (the chain-rival feed the runner does not need); one feed socket
FEED_SOURCE=sequencer
PROVIDER_WS=
FEED_URL=@FEED_URL@
RPC_URL=@RPC_URL@
LOGS_RPC_URL=@LOGS_RPC_URL@
SEQ_URL=@SEQ_URL@
FEED_SOCKETS=1
ETH_USD=2700
# the seat: E1, one shot from the wallet at the predicted tick plus the margin (no burst, no relay, no shooters)
SEAT=E1
SEND_MODE=predict
MARGIN_MS=60
BURST_N=1
SLOT_SEND=0
SLIP=0.25
# the launch filter the tables and the simulator used: a bundle of 3+ named wallets with 0.3+ ETH, the creator holding 1%+,
# quote ETH, the untaxed tier (tax 0-99 bps), NO fleet attacking at the build; no reputation floor, no team-share rule
BUNDLE_MIN=3
BUNDLE_MIN_ETH=0.3
BUNDLE_MAX_ETH=0
MIN_CREATOR_SUPPLY=0.01
MAX_CREATOR_BUY_ETH=2
NAMED_MAX=0
TIER_MIN_BPS=0
TIER_MAX_BPS=99
SKIP_TIER1_TEAM_SHARE=0
ATTACK_MIN=0
ATTACK_MAX=0
ATTACK_BUILD_MIN=0
REP_GATE=0
TRADE_HOURS=
MIN_RULE_PASSING_1H=0
MIN_FOLLOW_ETH_60=0
SWITCH=-9
SWITCH_N=15
# the stake: $10 fixed (raised by hand as the bankroll grows), the wallet not sized into it; the day stops at half the bankroll
STAKE_MIN=10
STAKE_MAX=10
WALLET_STAKE=0
FRAC=1
BANKROLL_USD=30
GAS_RESERVE_USD=1
SUPPLY_FRAC=0.03
STAKE_BOOST_USD=0
DAILY_STOP=0.5
KILL_USD=0
MAX_LIVE_TRADES=0
# the exit: the mark read every feed block and from the chain every 300 ms; sell at +30% or -30%, else at 300 blocks after the fill
HOLD_S=30
HOLD_BLOCKS=300
HOLD_FROM_FILL=1
EXIT_MARK=1
TAKE_PROFIT=0.30
STOP_LOSS=0.30
STOP_SELL_FRAC=0
MARK_POLL_MS=300
SELL_RESERVED_NONCE=0
# bookkeeping: its own log, its own P&L base (runner_setup.sh base) and withdrawals; no CPU pin (the sniper has core 1)
GAS_MAX_SHARE=0.10
GAS_HEADROOM=2.0
MAX_RESOLVE_MS=1500
REQUIRE_COINCURVE=1
PIN_CPU=
LOG_PATH=/var/log/sniper/runner.jsonl
PNL_BASE=0
PNL_WITHDRAWN=0
