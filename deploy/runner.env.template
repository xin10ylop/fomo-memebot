# The runner (runbook 5bj, rebuilt in 5bk): a second engine instance for the untaxed tier (token tax under 100 bps) on launches with
# NO crowd, entered at E1 on the sniper's proven path (a burst from its own shooters through its own buy-once relay, aimed with the
# slot model), exit on the mark: take-profit +30%, stop -30%, cap 300 blocks. Written by deploy/runner_setup.sh into
# /etc/sniper/runner.env (root, 0600); runner_setup.sh upgrade merges new keys into an existing file and keeps its values.
# Comments only on their own lines (systemd reads everything after '=' as the value).
# live: SEND_MODULE=/etc/sniper/runner_send_step.py (runner_setup.sh live copies this checkout's deploy/send_step.py there: the
# sniper's /etc/sniper/send_step.py is never touched); empty = DRY RUN (decisions logged, nothing sent)
SEND_MODULE=
PRIVATE_KEY=@PRIVATE_KEY@
WALLET=@WALLET@
# connections: the runner's OWN provider key (runner_setup.sh set-rpc; the sniper's key has a monthly quota the sniper needs), the
# public node for logs, the sequencer; the feed socket leaves from a SECOND public address (the feed allows two connections per
# address and the sniper uses both): runner_setup.sh add-ip sets FEED_LOCAL_ADDR, and the engine refuses to start without it
FEED_SOURCE=sequencer
PROVIDER_WS=
FEED_URL=@FEED_URL@
RPC_URL=@RPC_URL@
LOGS_RPC_URL=@LOGS_RPC_URL@
SEQ_URL=@SEQ_URL@
FEED_SOCKETS=1
FEED_LOCAL_ADDR=
REQUIRE_FEED_LOCAL_ADDR=1
CHAIN_POLL_S=10
RECEIPT_POLL_MS=40
PROBE_EVERY_S=0
ETH_USD=2700
# the seat: E1 through the relay, one shot per shooter, BURST_STEP_MS apart from BURST_LEAD_MS before the slot model's predicted
# seat block (the sniper's landing machinery; SLOT_LEAD_MS, FEED_LAG_MS and MARGIN_MS are the box's calibration, copied from the
# sniper's env at install). The relay buys once per curve and refuses a block stamped after the seat's second. BURST_SLIP 0.30, not
# the sniper's 0.20: the team's own exempt buys in the creation second's last block move the price, and 0.20 refused 21% of the
# priced fills (5bk re-pricing); a shot in the creation second still gets about 2% of its tokens and reverts, and the relay stops a
# second fill.
SEAT=E1
SEND_MODE=predict
SLOT_SEND=@SLOT_SEND@
SLOT_LEAD_MS=@SLOT_LEAD_MS@
FEED_LAG_MS=@FEED_LAG_MS@
MARGIN_MS=@MARGIN_MS@
BURST_N=24
SHOTS_PER_SHOOTER=1
BURST_STEP_MS=3
BURST_LEAD_MS=46
LATE_SEND_MIN_MS=70                     # 6.27: the engine's default 100 is above SLOT_LEAD_MS+BURST_LEAD_MS (96), which made the 6.24 late start unreachable here; 70 lets an aim passed by up to about 26 ms still fire before the tick
BURST_SLIP=0.30
RELAY=
SHOOTER_KEYS=
SHOOTER_MIN_ETH=0.000015
SHOOTER_TARGET_ETH=0.00004
RELAY_FLOAT_USD=12
# the launch filter the research priced: a bundle of 3+ named wallets with 0.3+ ETH, the creator holding 1%+, quote ETH, the untaxed
# tier (tax 0-99 bps, refused from the calldata before any lookup: TIER_EARLY), NO fleet attacking at the build (ATTACK_MAX 0; the
# build reads the crowd through the creation second's second-to-last block; a veto asked before every shot stops the shots that
# would land in the seat block when a fleet shows by then: the research's k-1 view; fleets fired before the curve was watched are
# back-filled)
BUNDLE_MIN=3
BUNDLE_MIN_ETH=0.3
BUNDLE_MAX_ETH=0
MIN_CREATOR_SUPPLY=0.01
MAX_CREATOR_BUY_ETH=2
NAMED_MAX=0
TIER_MIN_BPS=0
TIER_MAX_BPS=99
TIER_EARLY=1
TIER_ASSUMED=0.01
SKIP_TIER1_TEAM_SHARE=0
ATTACK_MIN=0
ATTACK_MAX=0
ATTACK_BUILD_MIN=0
REP_GATE=0
TRADE_HOURS=
MIN_RULE_PASSING_1H=0
MIN_FOLLOW_ETH_60=0
SWITCH=-9
SWITCH_N=15
# the stake: $10 a trade from the relay (raised by hand as the bankroll grows: STAKE_MIN, STAKE_MAX and RELAY_FLOAT_USD = 1.2 stakes);
# the day stops when wallet + relay fall 70% from the day's start (three rugs at $10 do not stop a $30 day; a runaway loop does)
STAKE_MIN=10
STAKE_MAX=10
STAKE_BOOST_USD=0
FRAC=1
BANKROLL_USD=30
GAS_RESERVE_USD=1
SUPPLY_FRAC=0.03
DAILY_STOP=0.7
KILL_USD=0
MAX_LIVE_TRADES=0
# the exit: the mark read every feed block and from the chain every 500 ms (the chain decides once it has a reading); sell at +30% or
# -30%, else 300 blocks after the fill
HOLD_S=30
HOLD_BLOCKS=300
HOLD_FROM_FILL=1
EXIT_MARK=1
TAKE_PROFIT=0.30
STOP_LOSS=0.30
STOP_SELL_FRAC=0
MARK_POLL_MS=500
SELL_RESERVED_NONCE=0
# bookkeeping: its own log, its own P&L base (runner_setup.sh base) and withdrawals; no CPU pin (the unit keeps it on core 0, Nice 10)
GAS_MAX_SHARE=0.10
MAX_RESOLVE_MS=1500
REQUIRE_COINCURVE=1
PIN_CPU=
LOG_PATH=/var/log/sniper/runner.jsonl
PNL_BASE=0
PNL_WITHDRAWN=0
